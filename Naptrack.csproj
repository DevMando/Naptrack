<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- dotnet tool -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>naptrack</ToolCommandName>
    <PackageId>Naptrack</PackageId>
    <Version>1.0.2</Version>
    <Authors>DevMando</Authors>
    <Description>Grab audio and video from the web. A TUI app to download MP3/MP4 from YouTube, TikTok, Instagram, Facebook, and 1000+ sites.</Description>
    <PackageProjectUrl>https://github.com/DevMando/Naptrack</PackageProjectUrl>
    <PackageTags>youtube;mp3;mp4;audio;video;downloader;tui;cli;tiktok;instagram</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>v1.0.2 - Fixes the standalone binaries, which showed only "Page not found" on every platform. Repairs ffmpeg setup on Windows and Apple Silicon, and yt-dlp setup on Alpine. Fixes a hang during the dependency check on Windows. Adds a notice when a newer version is available.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Self-contained publish (for standalone binaries) -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!--
      Trimming must stay off. The Razor router finds routable components by reflecting
      over assembly types, so the trimmer strips them as unreachable and every route
      404s: the published v1.0.0 and v1.0.1 standalone binaries render nothing but
      "Page not found. Press Tab to navigate." Microsoft.AspNetCore.Components warns
      about exactly this with IL2104 during publish.
    -->
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RazorConsole.Core" Version="0.3.0-alpha.*" />
  </ItemGroup>

</Project>
