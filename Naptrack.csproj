<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- dotnet tool -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>naptrack</ToolCommandName>
    <PackageId>Naptrack</PackageId>
    <Version>1.0.4</Version>
    <Authors>DevMando</Authors>
    <Description>Grab audio and video from the web. A TUI app to download MP3/MP4 from YouTube, TikTok, Instagram, Facebook, and 1000+ sites.</Description>
    <PackageProjectUrl>https://github.com/DevMando/Naptrack</PackageProjectUrl>
    <PackageTags>youtube;mp3;mp4;audio;video;downloader;tui;cli;tiktok;instagram</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>v1.0.4 - Fixes downloads failing with "Access denied" or what looked like being blocked. yt-dlp was fetched once on first run and never updated, so every install eventually fell far enough behind the sites it talks to that the media request came back 403 with no way to fix it from inside the app. yt-dlp now tracks the nightly channel, is checked once a day and updated automatically, and its version is shown in the app with a button to update it on demand. A stale system-installed yt-dlp is replaced with a managed copy. Node or Bun is used as a JavaScript runtime for YouTube when available. Interrupted updates can no longer leave a truncated binary behind.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Self-contained publish (for standalone binaries) -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!--
      Trimming must stay off. The Razor router finds routable components by reflecting
      over assembly types, so the trimmer strips them as unreachable and every route
      404s: the published v1.0.0 and v1.0.1 standalone binaries render nothing but
      "Page not found. Press Tab to navigate." Microsoft.AspNetCore.Components warns
      about exactly this with IL2104 during publish.
    -->
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RazorConsole.Core" Version="0.3.0-alpha.*" />
  </ItemGroup>

</Project>
