@page "/"
@using System.Globalization
@using Naptrack.Models
@using Naptrack.Services

@implements IDisposable

@inject ConfigService Config
@inject UpdateChecker Updater
@inject DependencyChecker DepChecker
@inject YtDlpUpdater YtDlpUpdate
@inject BinaryDownloader Downloader
@inject YtDlpService YtDlp
@inject FolderPickerService FolderPicker
@inject TextInputBufferSync InputBuffer
@inject InputLoopScheduler InputLoop
@inject RazorConsole.Core.Focus.FocusManager Focus

@* The version sits against the banner's last line, like a signature, rather than on a row of its
   own. Blank lines above it do the bottom-alignment, since Columns tops its cells. *@
<Align Horizontal="HorizontalAlignment.Center">
    <Columns>
        <Rows>
            @foreach (var line in _bannerLines)
            {
                <Markup Content="@line" Foreground="Theme.Accent" />
            }
        </Rows>
        <Rows>
            @for (var i = 1; i < _bannerLines.Length; i++)
            {
                <Markup Content=" " />
            }
            <Markup Content="@($"v{UpdateChecker.CurrentVersion}")" Foreground="Theme.Muted" />
        </Rows>
    </Columns>
</Align>
@if (Updater.UpdateAvailable)
{
    <Align Horizontal="HorizontalAlignment.Center">
        <Markup Content="@($"Update available: v{Updater.NewerVersion}  ({Updater.Command})")"
                Foreground="Theme.Warn" />
    </Align>
}

@if (_setupInProgress)
{
    <Panel Title="Setting Up" BorderColor="Theme.Warn" Expand="true">
        <Rows>
            <Spinner Message="@_setupMessage" SpinnerType="Spectre.Console.Spinner.Known.Binary" />
        </Rows>
    </Panel>
}
else if (_depsChecked && (!DepChecker.IsYtDlpInstalled || !DepChecker.IsFfmpegInstalled))
{
    <Panel Title="Setup Failed" BorderColor="Theme.Error" Expand="true">
        <Rows>
            <Markup Content="@_setupMessage" Foreground="Theme.Error" />
            @if (!DepChecker.IsYtDlpInstalled)
            {
                <Markup Content="yt-dlp could not be downloaded automatically." Foreground="Theme.Error" />
            }
            @if (!DepChecker.IsFfmpegInstalled)
            {
                <Markup Content="ffmpeg could not be downloaded automatically." Foreground="Theme.Error" />
            }
            <TextButton Content="[ Retry Setup ]"
                        OnClick="RunSetup"
                        BackgroundColor="Theme.Surface"
                        FocusedColor="Theme.Focus" />
        </Rows>
    </Panel>
}

<TextInput Value="@_url"
           ValueChanged="@((v) => OnUrlChanged(v))"
           OnSubmit="@((v) => StartDownload(_format))"
           @onkeydown="HandleKeyDown"
           Label="Paste URL (↑ for history, Esc to clear)"
           LabelColor="Theme.Accent"
           Placeholder="YouTube, TikTok, Instagram, Facebook..."
           PlaceholderColor="Theme.Muted"
           BorderStyle="BoxBorder.Rounded"
           BorderColor="Theme.Muted"
           FocusedBorderColor="Theme.Accent"
           Expand="true"
           Disabled="@_settingsMode"
           FocusOrder="1" />

@* Controls sit left, under the URL box, sharing one label column. Centring each cluster
   independently produced three different centre points beneath a full-width input, so no two
   rows shared an edge and the whole group read as clutter rather than as a set of choices. *@

@* One button per format, directly under the box, so choosing the format and starting the download
   are the same press. Tab walks URL box -> MP4 -> MP3 (and a running download's Cancel); Enter in
   the box repeats whichever format was used last.

   The remaining controls are labels driven by shortcuts, shown beside each. Those need the
   keyboard-loop hook (InputLoopScheduler); should it ever fail to take, Keyed stays false and they
   fall back to focusable buttons, so none of them can become unreachable. *@
@* Folder and yt-dlp float right of the buttons when the terminal is wide enough for both, and
   drop below as their own group when it is not: squeezed into 80 columns side by side, Spectre
   wraps every cell and the row turns into a tangle. *@
@{ var sideBySide = ConsoleWidth() >= SideBySideWidth; }

@if (sideBySide)
{
    <Grid Columns="2" Expand="true">
        @DownloadButtons
        <Align Horizontal="HorizontalAlignment.Right">
            @SettingsRows(true)
        </Align>
    </Grid>
}
else
{
    @DownloadButtons
}

@* Shown only for a link that carries a playlist, so the choice appears exactly when it matters
   and never becomes hidden state that silently changes what the next download does. *@
@if (HasPlaylist(_url))
{
    <Columns>
        <Markup Content="@Field("Playlist")" Foreground="Theme.Warn" />
        @if (Keyed)
        {
            <Markup Content="@Option(SingleItemLabel(_url), !_wholePlaylist)" Foreground="@OptionColor(!_wholePlaylist)" />
            <Markup Content="@Option("Whole playlist", _wholePlaylist)" Foreground="@OptionColor(_wholePlaylist)" />
            <Markup Content="Ctrl+P" Foreground="Theme.Muted" />
        }
        else
        {
            <TextButton Content="@Option(SingleItemLabel(_url), !_wholePlaylist)"
                        OnClick="() => _wholePlaylist = false"
                        BackgroundColor="Theme.Surface"
                        FocusedColor="Theme.Focus" />
            <TextButton Content="@Option("Whole playlist", _wholePlaylist)"
                        OnClick="() => _wholePlaylist = true"
                        BackgroundColor="Theme.Surface"
                        FocusedColor="Theme.Focus" />
        }
    </Columns>
}

@* Always rendered, blank when there is nothing to say, so submitting a URL never
   shifts the rows below it out from under the cursor. *@
<Markup Content="@_formMessage" Foreground="Theme.Error" />

@if (!sideBySide)
{
    @* Where files go and what is doing the work: a different question from what to download, so
       it gets its own group rather than another identically-spaced row. *@
    <Newline />
    @SettingsRows(false)
}

@if (!string.IsNullOrEmpty(_folderMessage))
{
    <Markup Content="@_folderMessage" Foreground="@_folderMessageColor" />
}

@if (_downloads.Count > 0)
{
    @* A local, not a field: mutating component state while the render tree is being built means
       a row can be measured against one width and its neighbour against another. *@
    var layout = Measure();

    <Panel Title="@DownloadsTitle" BorderColor="Theme.Muted" Expand="true">
        <Rows>
            @* Every row is the same component type whatever its state, and none of them are
               keyed. Both matter: a row that flipped from active to finished used to swap
               Columns for Markup under one @key, so the keyed diff had to remap a key onto a
               different component type — and when that component was the focused Cancel button,
               tearing it down mid-diff faulted the renderer. Positional diffing over a uniform
               structure is the well-trodden path, and the list is far too short for keys to buy
               anything. *@
            @foreach (var item in _downloads)
            {
                <Columns>
                    @if (item.IsActive)
                    {
                        @* One cell per colour, since RazorConsole escapes text and inline colour
                           tags are not an option: the spinner and bar carry the state, the title
                           stays plain white as the thing being read, the percentage is bold, and
                           speed and ETA recede into grey. Every cell is a fixed width, so the
                           columns still line up from row to row.

                           Spinner rather than a static bar: during conversion yt-dlp reports no
                           percentage for minutes at a time, and the animation is the only thing
                           distinguishing "working" from "hung". *@
                        var cells = CellsFor(item, layout);

                        <Spinner SpinnerType="Spectre.Console.Spinner.Known.Dots2" Style="@cells.SpinnerStyle" />
                        <Markup Content="@Fit(LabelOf(item), layout.Label)" />
                        <Markup Content="@cells.Progress" Foreground="@cells.ProgressColor" />
                        <Markup Content="@cells.Value" Foreground="@cells.ValueColor" Decoration="@cells.ValueDecoration" />
                        <Markup Content="@cells.Detail" Foreground="Theme.Muted" />
                        <TextButton Content="[ Cancel ]"
                                    OnClick="() => Cancel(item)"
                                    BackgroundColor="Theme.Surface"
                                    FocusedColor="Theme.Error" />
                    }
                    else
                    {
                        <Markup Content="@FinishedLine(item, layout)" Foreground="@FinishedColor(item)" />
                    }
                </Columns>
            }
        </Rows>
    </Panel>
}

<Markup Content="@ShortcutsLine" Foreground="Theme.Muted" />

@code {
    /// <summary>
    /// One place for every colour the UI uses. Roles, not shades, so a restyle is a change here
    /// rather than a grep across the file.
    /// </summary>
    private static class Theme
    {
        public static readonly Color Accent = Color.DodgerBlue2;
        public static readonly Color Muted = Color.Grey;
        public static readonly Color Success = Color.Green;
        public static readonly Color Error = Color.Red;
        public static readonly Color Warn = Color.Yellow;
        public static readonly Color Notice = Color.MediumPurple1;
        public static readonly Color Focus = Color.Blue1;
        public static readonly Color Surface = Color.Black;
    }

    private static readonly string[] _bannerLines =
    [
        "███╗   ██╗ █████╗ ██████╗ ████████╗██████╗  █████╗  ██████╗██╗  ██╗",
        "████╗  ██║██╔══██╗██╔══██╗╚══██╔══╝██╔══██╗██╔══██╗██╔════╝██║ ██╔╝",
        "██╔██╗ ██║███████║██████╔╝   ██║   ██████╔╝███████║██║     █████╔╝ ",
        "██║╚██╗██║██╔══██║██╔═══╝    ██║   ██╔══██╗██╔══██║██║     ██╔═██╗ ",
        "██║ ╚████║██║  ██║██║        ██║   ██║  ██║██║  ██║╚██████╗██║  ██╗",
        "╚═╝  ╚═══╝╚═╝  ╚═╝╚═╝        ╚═╝   ╚═╝  ╚═╝╚═╝  ╚═╝ ╚═════╝╚═╝  ╚═╝",
    ];

    private static readonly string _pasteHint =
        System.Runtime.InteropServices.RuntimeInformation.IsOSPlatform(System.Runtime.InteropServices.OSPlatform.Windows)
            ? "Ctrl+V: paste"
        : System.Runtime.InteropServices.RuntimeInformation.IsOSPlatform(System.Runtime.InteropServices.OSPlatform.OSX)
            ? "Cmd+V: paste"
            : "Ctrl+Shift+V: paste";

    // Ctrl+C is listed because it is now the only way out: the Quit button is gone, and Esc
    // clears the URL box rather than exiting.
    private string ShortcutsLine =>
        _settingsMode
            ? "Tab: move  |  Enter: select  |  Shift+Tab: downloads  |  Esc: back  |  Ctrl+C: quit"
        : Keyed
            ? $"Tab: move  |  Shift+Tab: settings  |  ↑↓: history  |  Esc: clear  |  {_pasteHint}  |  Ctrl+C: quit"
            : $"Tab: move  |  Enter: select  |  ↑↓: history  |  Esc: clear  |  {_pasteHint}  |  Ctrl+C: quit";

    /// <summary>
    /// Parallel yt-dlp runs past this point mostly fight each other for bandwidth, and each one
    /// spawns an ffmpeg conversion at the end. Extra submissions wait as "Queued".
    /// </summary>
    private const int MaxConcurrent = 3;

    /// <summary>Finished rows kept before the oldest are dropped, so the list cannot outgrow the screen.</summary>
    private const int MaxFinished = 5;

    /// <summary>Total yt-dlp runs per download, including the first. Only transient failures retry.</summary>
    private const int MaxAttempts = 3;

    /// <summary>Backoff before retry N, multiplied by the attempt number: 3s, then 6s.</summary>
    private const int RetryBackoffSeconds = 3;

    /// <summary>Submitted URLs recalled with the up arrow.</summary>
    private const int MaxHistory = 25;

    /// <summary>
    /// Everything in an active row that is neither the label, the bar, nor the rate. Each cell
    /// is followed by a one-column gap: spinner and its trailing space(2) + gap(1), label gap(1),
    /// bar gap(1), percent(6) + gap(1), rate gap(1), "[ Cancel ]"(10) + gap(1), and the panel's
    /// border and padding(4).
    /// </summary>
    private const int RowChrome = 28;

    /// <summary>Worst-case width of "850KiB/s · 01:02:03".</summary>
    private const int RateWidth = 20;

    private const int MinLabel = 12;
    private const int MinBar = 8;

    /// <summary>
    /// Column widths for one render pass, derived from the live console width. A value rather
    /// than fields so nothing about the layout is stored on the component mid-render.
    /// </summary>
    private readonly record struct RowLayout(
        int Label,
        int Bar,
        int Row,
        int Active,
        bool ShowRate);

    private readonly List<DownloadItem> _downloads = [];
    private readonly SemaphoreSlim _slots = new(MaxConcurrent, MaxConcurrent);
    private int _nextId = 1;

    /// <summary>
    /// How often the pump repaints while anything has changed. yt-dlp emits progress lines many
    /// times a second per download, so repainting on each one meant hundreds of full tree diffs
    /// a second across three downloads; ten a second is more than the eye resolves.
    /// </summary>
    private static readonly TimeSpan RenderInterval = TimeSpan.FromMilliseconds(100);

    private static readonly TimeSpan FolderMessageLifetime = TimeSpan.FromSeconds(6);

    /// <summary>
    /// Guards every state mutation and every repaint.
    ///
    /// RazorConsole's renderer hands out an ImmediateDispatcher whose InvokeAsync simply invokes
    /// the delegate on the calling thread — CheckAccess() is hardcoded to true and nothing is
    /// marshalled. So InvokeAsync(StateHasChanged) from a yt-dlp reader thread renders *on that
    /// thread*, and with several downloads running, plus the keyboard thread, several threads
    /// end up inside Blazor's RenderTreeDiffBuilder at once. It is not thread safe, and the
    /// result is a NullReferenceException in the diff.
    /// </summary>
    private readonly object _sync = new();

    /// <summary>Set by any thread that changed something; cleared by the pump when it repaints.</summary>
    private volatile bool _dirty;

    private CancellationTokenSource? _pump;

    /// <summary>When the last repaint happened, for throttling to <see cref="RenderInterval"/>.</summary>
    private long _lastRender;

    private string _folderMessage = "";
    private Color _folderMessageColor = Theme.Muted;
    private int _folderMessageSeq;

    private string _url = "";
    private string _formMessage = "";
    private bool _wholePlaylist;

    /// <summary>Submitted URLs, oldest first. Backed by the config so it survives a restart.</summary>
    private List<string> _history => Config.Config.RecentUrls;

    /// <summary>Cursor into <see cref="_history"/> while browsing it; -1 when not browsing.</summary>
    private int _historyIndex = -1;

    /// <summary>Whatever was typed before the up arrow was first pressed, restored by arrowing back down.</summary>
    private string _draft = "";

    private DownloadFormat _format = DownloadFormat.Mp3;
    private bool _depsChecked;
    private bool _setupInProgress;
    private string _setupMessage = "";

    private bool _ytDlpUpdating;
    private string _ytDlpMessage = "";
    private Color _ytDlpMessageColor = Theme.Muted;

    private string YtDlpStatusText
    {
        get
        {
            var version = string.IsNullOrWhiteSpace(DepChecker.YtDlpVersion)
                ? "unknown version"
                : DepChecker.YtDlpVersion;

            var source = DepChecker.IsYtDlpManaged ? "" : " (system)";

            return DepChecker.IsYtDlpStale
                ? $"{version}{source} - out of date"
                : $"{version}{source}";
        }
    }

    private Color YtDlpStatusColor => DepChecker.IsYtDlpStale ? Theme.Warn : Theme.Muted;

    /// <summary>
    /// Width every row label is padded to. The label column is what makes the rows line up, so
    /// it has to be wider than the longest label ("Playlist") with a gap left over.
    /// </summary>
    private const int LabelWidth = 10;

    /// <summary>
    /// Pads a row label so every control starts at the same column. Indented by two so the block
    /// sits inside the URL box's border rather than flush against the terminal edge.
    /// </summary>
    private static string Field(string label) => "  " + label.PadRight(LabelWidth);

    /// <summary>
    /// Terminal width from which Folder and yt-dlp sit beside the download buttons: the buttons
    /// take about 36 columns and the two lines up to about 60 with a long path or version.
    /// </summary>
    private const int SideBySideWidth = 100;

    /// <summary>
    /// One button per format, directly under the URL box. Dimmed labels in settings mode, so Tab
    /// there reaches only the settings.
    /// </summary>
    private RenderFragment DownloadButtons => @<Columns>
        <Markup Content=" " />
        @if (_settingsMode)
        {
            <Markup Content="[ Download MP4 ]" Foreground="Theme.Muted" />
            <Markup Content="[ Download MP3 ]" Foreground="Theme.Muted" />
        }
        else
        {
            <TextButton Content="[ Download MP4 ]"
                        OnClick="() => StartDownload(DownloadFormat.Mp4)"
                        BackgroundColor="Theme.Surface"
                        FocusedColor="Theme.Focus" />
            <TextButton Content="[ Download MP3 ]"
                        OnClick="() => StartDownload(DownloadFormat.Mp3)"
                        BackgroundColor="Theme.Surface"
                        FocusedColor="Theme.Focus" />
        }
    </Columns>;

    /// <summary>
    /// The Folder and yt-dlp lines. Beside the buttons they drop the shared label column, which
    /// only earns its width when these rows line up under the others on the left.
    ///
    /// Their buttons look the same in both modes but only take focus in settings mode. Swapping a
    /// focusable control for a label is also what moves focus: when the focused element stops
    /// being focusable, RazorConsole hands focus to the first one that still is, so entering the
    /// mode lands on Change and leaving it lands back on the URL box, with no focus API needed.
    /// </summary>
    private RenderFragment SettingsRows(bool sideBySide) => @<Rows>
        <Columns>
            <Markup Content="@SettingLabel("Folder", sideBySide)" Foreground="Theme.Muted" />

            @* The path is text, never a button: settings mode lands on the first focusable control,
               and that should be Change, the thing people come here to do. *@
            <Markup Content="@Shorten(Config.Config.DownloadFolder)" />
            @if (!SettingsFocusable)
            {
                <Markup Content="[ Change ]" />
                <Markup Content="[ Open ]" />
            }
            else
            {
                <TextButton Content="[ Change ]"
                            OnClick="ChangeFolder"
                            BackgroundColor="Theme.Surface"
                            FocusedColor="Theme.Focus" />
                <TextButton Content="[ Open ]"
                            OnClick="OpenDownloadFolder"
                            BackgroundColor="Theme.Surface"
                            FocusedColor="Theme.Focus" />
            }
        </Columns>

        @* The downloader's own version, surfaced deliberately. When a site starts refusing
           downloads this is the first thing that matters, and before it was on screen there was
           no way to tell a genuinely unavailable video from a yt-dlp that had simply gone stale. *@
        @if (_depsChecked && DepChecker.IsYtDlpInstalled)
        {
            <Columns>
                <Markup Content="@SettingLabel("yt-dlp", sideBySide)" Foreground="Theme.Muted" />
                <Markup Content="@YtDlpStatusText" Foreground="@YtDlpStatusColor" />
                @if (!SettingsFocusable)
                {
                    <Markup Content="@(_ytDlpUpdating ? "[ Updating... ]" : "[ Update ]")" />
                }
                else
                {
                    <TextButton Content="@(_ytDlpUpdating ? "[ Updating... ]" : "[ Update ]")"
                                OnClick="UpdateYtDlpAsync"
                                BackgroundColor="Theme.Surface"
                                FocusedColor="Theme.Focus" />
                }
            </Columns>
        }

        @* Directly under the row it reports on -- "Checking...", "already up to date", a failure --
           rather than at the bottom of the form, where it read as belonging to something else. *@
        @if (!string.IsNullOrEmpty(_ytDlpMessage))
        {
            <Markup Content="@(sideBySide ? _ytDlpMessage : Field("") + _ytDlpMessage)" Foreground="@_ytDlpMessageColor" />
        }
    </Rows>;

    private static string SettingLabel(string label, bool sideBySide) =>
        sideBySide ? label.PadRight(7) : Field(label);

    /// <summary>
    /// Whether the keyboard-loop hook is doing its job, so Shift+Tab and the shortcuts work.
    /// Assumed during a short grace period after startup once the proxy is installed: the first
    /// render comes before the loop's first poll, and judging by that alone flashed the fallback
    /// layout on every launch.
    /// </summary>
    private bool Keyed =>
        InputLoop.HasHooked
        || (InputLoop.Installed && Environment.TickCount64 - _startedAt < HookGraceMs);

    private const long HookGraceMs = 3000;

    private readonly long _startedAt = Environment.TickCount64;

    /// <summary>
    /// Settings mode, entered with Shift+Tab: the URL box and download buttons stop taking focus
    /// and the Folder and yt-dlp buttons start, so Tab walks only those.
    /// </summary>
    private bool _settingsMode;

    /// <summary>
    /// Whether the Folder and yt-dlp buttons take focus: in settings mode, or always when the hook
    /// is missing, since then Shift+Tab cannot reach them any other way.
    /// </summary>
    private bool SettingsFocusable => _settingsMode || !Keyed;

    private static string Option(string label, bool selected) => (selected ? "● " : "○ ") + label;

    // Colour is free to mark the selection on a label: with nothing focusable there, no background
    // is competing to show focus.
    private static Color OptionColor(bool selected) => selected ? Theme.Accent : Theme.Muted;

    /// <summary>
    /// Handles the keys for everything Tab no longer reaches. Runs on RazorConsole's keyboard loop,
    /// before the key is delivered anywhere, whichever control has focus; returning true consumes
    /// it. Ctrl combinations were picked to avoid the ones terminals keep for themselves: A, C, F,
    /// M and V in the Windows console, S, Q and Z for flow control and suspend on Unix, and I, H
    /// and J, which arrive as Tab, Backspace and Enter.
    /// </summary>
    private bool HandleShortcut(ConsoleKeyInfo key)
    {
        var ctrl = key.Modifiers == ConsoleModifiers.Control;
        var plain = key.Modifiers == 0;

        switch (key.Key)
        {
            case ConsoleKey.Tab when key.Modifiers == ConsoleModifiers.Shift:
                SwitchMode(!_settingsMode);
                break;

            // Esc backs out of settings mode. Anywhere else it is left alone, for the URL box to
            // clear itself.
            case ConsoleKey.Escape when plain && _settingsMode:
                SwitchMode(false);
                break;

            case ConsoleKey.P when ctrl:
                // Only meaningful while the playlist row is showing. Consumed either way, so the
                // key never reaches the URL box.
                if (HasPlaylist(_url))
                    Update(() => _wholePlaylist = !_wholePlaylist);
                break;

            case ConsoleKey.E when ctrl:
                OpenDownloadFolder();
                break;

            case ConsoleKey.L when ctrl:
                Fire(ChangeFolder);
                break;

            case ConsoleKey.U when ctrl:
                if (_depsChecked && DepChecker.IsYtDlpInstalled)
                    Fire(UpdateYtDlpAsync);
                break;

            default:
                return false;
        }

        // Painted on the next poll rather than after the usual throttle, so a shortcut answers as
        // promptly as a click did.
        _lastRender = 0;
        return true;
    }

    /// <summary>
    /// Starts a shortcut's work without holding up the keyboard loop -- the folder picker alone can
    /// sit open for as long as the user likes -- and without letting a failure escape unobserved.
    /// </summary>
    private static async void Fire(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch
        {
            // Each action reports its own failures on screen.
        }
    }

    private string DownloadsTitle
    {
        get
        {
            var active = _downloads.Count(d => d.IsActive);
            return active > 0 ? $"Downloads ({active} active)" : "Downloads";
        }
    }

    /// <summary>
    /// Applies a state change and asks for a repaint, instead of repainting inline. Every mutation
    /// goes through here, so the pump can never diff a half-updated list and no background thread
    /// ever touches the renderer itself. See <see cref="_sync"/> for why that matters.
    /// </summary>
    private void Update(Action change)
    {
        lock (_sync)
        {
            change();
        }

        _dirty = true;
    }

    /// <summary>Focus key when the mode last switched, until focus has visibly moved off it.</summary>
    private string? _focusKeyAtSwitch;

    /// <summary>When a pending re-focus stops waiting, if focus never moves at all.</summary>
    private long _refocusDeadline;

    private bool _refocusPending;

    /// <summary>
    /// Enters or leaves settings mode. The swap of focusable controls moves focus by itself, but
    /// RazorConsole announces that move by first sending "focus out" to the control that just
    /// stopped taking focus -- whose handler the same render has already replaced -- and that
    /// failure abandons the "focus in" meant for the new one. Focus lands correctly and shows
    /// nothing until Tab is pressed, so the move is re-announced once it has happened.
    /// </summary>
    private void SwitchMode(bool settings)
    {
        _focusKeyAtSwitch = Focus.CurrentFocusKey;
        _refocusDeadline = Environment.TickCount64 + 1000;
        _refocusPending = true;

        Update(() => _settingsMode = settings);
    }

    /// <summary>
    /// Once focus has moved off the control it was on at the switch, steps it forward and straight
    /// back. Both steps go through RazorConsole's own focus API with live handlers, so the control
    /// that now has focus receives the "focus in" it missed and draws its highlight. Runs on the
    /// keyboard loop, so the two steps cannot interleave with a keystroke.
    /// </summary>
    private void RefocusIfSettled()
    {
        if (!_refocusPending)
            return;

        if (Focus.CurrentFocusKey == _focusKeyAtSwitch)
        {
            // Focus had nowhere to go -- a download's Cancel stays focusable in both modes -- so
            // there is nothing to re-announce.
            if (Environment.TickCount64 > _refocusDeadline)
                _refocusPending = false;

            return;
        }

        _refocusPending = false;
        _ = BounceFocusAsync();
    }

    private async Task BounceFocusAsync()
    {
        try
        {
            await Focus.FocusNextAsync();
            await Focus.FocusPreviousAsync();
        }
        catch
        {
            // Cosmetic only: focus is already where it should be.
        }
    }

    /// <summary>
    /// The only place background changes are painted from. Called on RazorConsole's keyboard loop
    /// (see <see cref="InputLoopScheduler"/>), so a repaint never overlaps the renders that
    /// keystrokes and clicks cause: overlapping them dropped updates, leaving a pasted URL or a
    /// cancelled row invisible until Tab made the component render again.
    /// </summary>
    private void RenderIfDirty()
    {
        RefocusIfSettled();

        if (!_dirty)
            return;

        var now = Environment.TickCount64;
        if (now - _lastRender < (long)RenderInterval.TotalMilliseconds)
            return;

        _lastRender = now;
        _dirty = false;

        lock (_sync)
        {
            StateHasChanged();
        }
    }

    /// <summary>
    /// Fallback for when the keyboard loop is not polling through <see cref="InputLoopScheduler"/>
    /// -- a RazorConsole build whose internals moved, or before its loop has started. Idle
    /// otherwise, so there is only ever one source of background repaints.
    /// </summary>
    private async Task RenderPumpAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(RenderInterval);

        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (InputLoop.IsPolling)
                    continue;

                // Keyed may just have flipped to the fallback layout, which nothing else would
                // mark dirty. Only reached when the hook is not working, so the cost is moot.
                if (!InputLoop.HasHooked)
                    _dirty = true;

                RenderIfDirty();
            }
        }
        catch (OperationCanceledException)
        {
            // Shutting down.
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _pump = new CancellationTokenSource();
        _ = RenderPumpAsync(_pump.Token);
        InputLoop.Register(RenderIfDirty);
        InputLoop.RegisterShortcuts(HandleShortcut);

        await Config.LoadAsync();

        _format = Config.Config.Format;

        // Deliberately not awaited: a slow or unreachable nuget.org must never
        // delay dependency setup or the first paint.
        _ = RefreshUpdateStatusAsync();

        await RunSetup();
    }

    private async Task SetFormat(DownloadFormat format)
    {
        if (_format == format)
            return;

        // Through Update: from a shortcut there is no event handler to repaint afterwards.
        Update(() =>
        {
            _format = format;
            Config.Config.Format = format;
        });

        await SaveConfigAsync();
    }

    private async Task SaveConfigAsync()
    {
        try
        {
            await Config.SaveAsync();
        }
        catch
        {
            // An unwritable config costs the user their preferences next launch, which is not
            // worth interrupting a working session over.
        }
    }

    private async Task RefreshUpdateStatusAsync()
    {
        await Updater.CheckAsync();

        if (Updater.UpdateAvailable)
            Update(() => { });
    }

    private async Task RunSetup()
    {
        Update(() =>
        {
            _setupInProgress = true;
            _setupMessage = "Checking dependencies...";
        });

        await DepChecker.CheckAsync();

        if (!DepChecker.IsYtDlpInstalled)
        {
            Update(() => _setupMessage = "Downloading yt-dlp...");

            await Downloader.DownloadYtDlpAsync(msg => Update(() => _setupMessage = msg));

            // Re-check after download
            await DepChecker.CheckAsync();
        }

        if (!DepChecker.IsFfmpegInstalled)
        {
            Update(() => _setupMessage = "Downloading ffmpeg (this may take a minute)...");

            await Downloader.DownloadFfmpegAsync(msg => Update(() => _setupMessage = msg));

            // Re-check after download
            await DepChecker.CheckAsync();
        }

        // Freshness, not just presence. A yt-dlp that exists but is weeks old is the most common
        // cause of a download that fails as though the site had blocked the user, and until this
        // ran the binary fetched on first install was never looked at again.
        if (DepChecker.IsYtDlpInstalled)
        {
            var outcome = await YtDlpUpdate.EnsureCurrentAsync(
                force: false,
                onStatus: msg => Update(() => _setupMessage = msg));

            // The version on screen comes from the binary itself, so it has to be re-read before
            // the status line can be trusted.
            if (outcome == YtDlpUpdater.Outcome.Updated)
                await DepChecker.CheckAsync();
        }

        Update(() =>
        {
            _setupInProgress = false;
            _depsChecked = true;

            _setupMessage = DepChecker.IsYtDlpInstalled && DepChecker.IsFfmpegInstalled
                ? ""
                : "Some dependencies could not be installed automatically.";
        });
    }

    /// <summary>
    /// Fetches the newest yt-dlp on demand, ignoring the once-a-day throttle. This is the button
    /// the error messages point at: someone staring at "Access denied" wants the current binary
    /// now, not to be told Naptrack already checked this morning.
    /// </summary>
    private async Task UpdateYtDlpAsync()
    {
        if (_ytDlpUpdating)
            return;

        // Windows will not replace a binary that a running process still has mapped, and the
        // failure would land as an unexplained "could not update" rather than anything the user
        // could act on. Saying so up front is the honest version.
        if (_downloads.Any(d => d.IsActive))
        {
            ShowYtDlpMessage("Finish or cancel the downloads in progress first.", Theme.Warn);
            return;
        }

        Update(() =>
        {
            _ytDlpUpdating = true;
            _ytDlpMessage = "";
        });

        var outcome = await YtDlpUpdate.EnsureCurrentAsync(
            force: true,
            onStatus: msg => Update(() =>
            {
                _ytDlpMessage = msg;
                _ytDlpMessageColor = Theme.Muted;
            }));

        await DepChecker.CheckAsync();

        Update(() => _ytDlpUpdating = false);

        switch (outcome)
        {
            case YtDlpUpdater.Outcome.Updated:
                ShowYtDlpMessage($"yt-dlp updated to {DepChecker.YtDlpVersion}.", Theme.Success);
                break;

            case YtDlpUpdater.Outcome.Failed:
                ShowYtDlpMessage("Could not update yt-dlp. Check your connection and try again.", Theme.Error);
                break;

            default:
                ShowYtDlpMessage("yt-dlp is already up to date.", Theme.Muted);
                break;
        }
    }

    private void ShowYtDlpMessage(string message, Color color)
    {
        Update(() =>
        {
            _ytDlpMessage = message;
            _ytDlpMessageColor = color;
        });
    }

    // Key names come from ConsoleKey.ToString(), so the up arrow arrives as "UpArrow". The DOM
    // spellings are accepted too, in case the event is ever synthesised from a browser-style source.
    // Every branch here goes through Update, and that is what makes it work rather than just what
    // makes it consistent. TextInput keeps its own copy of the text and only re-reads the Value
    // parameter when it is handed a render; assigning _url without marking the component dirty
    // left the box showing the old text forever, because the repaint that would have delivered
    // the new value never happened.
    private void HandleKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape":
                Update(() =>
                {
                    _url = "";
                    _formMessage = "";
                    _historyIndex = -1;
                    _draft = "";
                    _wholePlaylist = false;
                });
                InputBuffer.Reset("");
                break;

            case "UpArrow" or "ArrowUp":
                RecallOlder();
                break;

            case "DownArrow" or "ArrowDown":
                RecallNewer();
                break;
        }
    }

    private void OnUrlChanged(string value)
    {
        if (value == _url)
            return;

        Update(() =>
        {
            _url = value;

            // An edit ends history browsing, so the next up arrow starts again from the newest entry.
            _historyIndex = -1;
        });
    }

    private void RecallOlder()
    {
        if (_history.Count == 0)
            return;

        if (_historyIndex < 0)
        {
            _draft = _url;
            _historyIndex = _history.Count;
        }

        if (_historyIndex == 0)
            return;

        Update(() => _url = _history[--_historyIndex]);
        InputBuffer.Reset(_url);
    }

    private void RecallNewer()
    {
        if (_historyIndex < 0)
            return;

        _historyIndex++;

        if (_historyIndex >= _history.Count)
        {
            _historyIndex = -1;
            Update(() => _url = _draft);
            InputBuffer.Reset(_url);
            return;
        }

        Update(() => _url = _history[_historyIndex]);
        InputBuffer.Reset(_url);
    }

    private void Remember(string url)
    {
        // A resubmitted URL moves to the newest slot instead of appearing twice.
        //
        // Built as a new list and swapped in, never edited in place: the save below serialises
        // the config on another thread, and a list mutated under the serialiser throws
        // "Collection was modified", losing the save.
        Config.Config.RecentUrls = _history
            .Where(u => u != url)
            .Append(url)
            .TakeLast(MaxHistory)
            .ToList();

        _historyIndex = -1;
        _draft = "";

        _ = SaveConfigAsync();
    }

    /// <param name="format">
    /// The button pressed, or the last format used when the download came from Enter in the box.
    /// </param>
    private void StartDownload(DownloadFormat format)
    {
        var url = _url.Trim();

        if (string.IsNullOrWhiteSpace(url))
        {
            Update(() => _formMessage = "Paste a link first.");
            return;
        }

        if (!url.StartsWith("http://") && !url.StartsWith("https://"))
        {
            Update(() => _formMessage = "Invalid URL. Please enter a valid link.");
            return;
        }

        // Setup may be replacing yt-dlp right now, and until it finishes the dependency flags
        // below are not an answer yet either.
        if (_setupInProgress)
        {
            Update(() => _formMessage = "Still setting up. Try again in a moment.");
            return;
        }

        if (!DepChecker.IsYtDlpInstalled || !DepChecker.IsFfmpegInstalled)
        {
            Update(() => _formMessage = "Missing dependencies. Retry setup above.");
            return;
        }

        // The other half of the guard in UpdateYtDlpAsync. That one refuses to replace the binary
        // while downloads are running; this one refuses to start one while it is being replaced,
        // which would otherwise launch a yt-dlp that is mid-swap.
        if (_ytDlpUpdating)
        {
            Update(() => _formMessage = "yt-dlp is updating. Try again in a moment.");
            return;
        }

        var wholePlaylist = _wholePlaylist && HasPlaylist(url);

        // Pressing Enter twice is easy, and starting the same download a second time would have
        // both runs fighting over one partial file. Compared by what the link points at rather
        // than its text, since youtu.be/x and youtube.com/watch?v=x&t=42 are the same file. The
        // format is part of it: an MP3 and an MP4 of one video write different files, and asking
        // for both is exactly what two buttons invite.
        var key = DownloadKey(url, wholePlaylist);
        if (_downloads.Any(d => d.IsActive && d.Format == format && DownloadKey(d.Url, d.WholePlaylist) == key))
        {
            Update(() => _formMessage = "That link is already downloading.");
            return;
        }

        var item = new DownloadItem
        {
            Id = _nextId++,
            Url = url,
            Format = format,

            // Captured per download, so changing the toggle afterwards cannot retroactively
            // turn a running single-video job into a whole-playlist one.
            WholePlaylist = wholePlaylist,

            // Likewise the folder: changing it mid-download must not relabel where this one went.
            Folder = Config.Config.DownloadFolder,
        };

        Update(() =>
        {
            _downloads.Add(item);

            // Emptied as soon as the download is accepted, so the box is ready for the next link
            // rather than something to clear by hand first. The URL is not lost: Remember below
            // puts it at the top of the history, so the up arrow brings it straight back if the
            // download fails and needs another go.
            _url = "";
            _formMessage = "";
            _historyIndex = -1;
            _draft = "";

            // Reset with the URL that justified it. The toggle only appears for a playlist link,
            // so leaving it set would carry an invisible choice onto the next one.
            _wholePlaylist = false;
        });

        // Without this the box looks empty but RazorConsole's keystroke buffer still holds the
        // submitted URL, and the next paste is appended to it. See TextInputBufferSync.
        InputBuffer.Reset("");

        Remember(url);

        // Remembered, so Enter in the box repeats the last button pressed.
        _ = SetFormat(format);

        _ = RunAsync(item);
    }

    private async Task RunAsync(DownloadItem item)
    {
        try
        {
            await _slots.WaitAsync(item.Cts.Token);
        }
        catch (Exception)
        {
            // Cancelled while still queued, or the app is shutting down: either way no process
            // was ever started, and the slot was never taken so there is nothing to release.
            // Caught broadly because this task is not awaited, so an escaping exception would
            // surface on the finalizer thread instead of anywhere useful.
            item.Settled = true;
            Finish(item, DownloadStatus.Cancelled, "");
            return;
        }

        try
        {
            for (var attempt = 1; ; attempt++)
            {
                // Checked before every attempt, the first included: a row cancelled while queued
                // can win its slot before the background Cancel() has tripped the token, and
                // would otherwise start yt-dlp only to kill it a moment later.
                if (item.IsCancelled)
                {
                    Finish(item, DownloadStatus.Cancelled, "");
                    return;
                }

                var result = await AttemptAsync(item, attempt);

                var giveUp = result.Success
                    || !result.Retryable
                    || attempt >= MaxAttempts
                    || item.IsCancelled;

                if (giveUp)
                {
                    Commit(item, result);
                    return;
                }

                await BackOffAsync(item, attempt, result.Message);
            }
        }
        catch (Exception ex)
        {
            // Last line of defence for an un-awaited task: anything that escapes DownloadAsync
            // would otherwise leave this row spinning forever with no explanation.
            Finish(item, DownloadStatus.Error, ex.Message);
        }
        finally
        {
            // Released only now, not when the row was marked cancelled: the slot belongs to the
            // process until it is actually gone, or a fourth download would start alongside it.
            item.Settled = true;
            _slots.Release();
        }
    }

    /// <summary>
    /// Runs yt-dlp once and returns its outcome without committing it to the row, so the caller
    /// can decide whether a transient failure is worth another attempt.
    /// </summary>
    private async Task<DownloadResult> AttemptAsync(DownloadItem item, int attempt)
    {
        // Only assigned from onComplete, which YtDlpService invokes synchronously before
        // DownloadAsync returns.
        var outcome = new DownloadResult(false, "Download failed unexpectedly.", "");

        // Every update below is skipped once the row is cancelled. Cancel() settles the row at
        // once, but yt-dlp keeps printing until the kill lands, and each progress line used to
        // set the status straight back to Downloading -- reviving the spinner and a Cancel
        // button that no longer did anything.
        UpdateLive(item, () =>
        {
            item.Attempt = attempt;
            item.Status = DownloadStatus.Downloading;

            // Reset the readout rather than leaving the failed attempt's numbers frozen on the
            // row. yt-dlp resumes the partial file, so the bar climbs back quickly.
            item.Percent = 0;
            item.Speed = "";
            item.Eta = "";
        });

        await YtDlp.DownloadAsync(
            item.Url,
            item.Folder,
            item.Format,
            item.WholePlaylist,
            onProgress: p => UpdateLive(item, () =>
            {
                item.Percent = p.Percent;
                item.Speed = p.Speed;
                item.Eta = p.Eta;

                // Converting is driven only by yt-dlp's own [ExtractAudio]/[Merger] lines, never
                // inferred from 100%. An MP4 downloads the video stream to 100% and then the
                // audio stream from 0%, so treating the first 100% as "merging" would mislabel
                // the whole second stream.
                item.Status = DownloadStatus.Downloading;
            }),
            onStatus: msg => UpdateLive(item, () =>
            {
                if (msg.StartsWith("Converting") || msg.StartsWith("Merging"))
                    item.Status = DownloadStatus.Converting;
            }),
            onMetadata: meta => UpdateLive(item, () =>
            {
                if (!string.IsNullOrEmpty(meta.FileName))
                    item.FileName = meta.FileName;

                if (meta.PlaylistCount > 0)
                {
                    item.PlaylistIndex = meta.PlaylistIndex;
                    item.PlaylistCount = meta.PlaylistCount;
                }
            }),
            onComplete: result => outcome = result,
            ct: item.Cts.Token
        );

        return outcome;
    }

    /// <summary>Applies a change to a row unless the user has cancelled it.</summary>
    private void UpdateLive(DownloadItem item, Action change) =>
        Update(() =>
        {
            if (!item.IsCancelled)
                change();
        });

    /// <summary>Waits out the backoff a second at a time so the row can show a live countdown.</summary>
    private async Task BackOffAsync(DownloadItem item, int attempt, string reason)
    {
        for (var remaining = attempt * RetryBackoffSeconds; remaining > 0; remaining--)
        {
            var secondsLeft = remaining;

            UpdateLive(item, () =>
            {
                item.Status = DownloadStatus.Retrying;
                item.Message = reason;
                item.RetryIn = secondsLeft;
            });

            try
            {
                await Task.Delay(TimeSpan.FromSeconds(1), item.Cts.Token);
            }
            catch (OperationCanceledException)
            {
                return;
            }
        }
    }

    private void Commit(DownloadItem item, DownloadResult result)
    {
        Update(() =>
        {
            if (!string.IsNullOrEmpty(result.FileName))
                item.FileName = result.FileName;

            // A row the user already cancelled stays cancelled. Cancel() settles it optimistically
            // and requests the token from a background thread, so the run can unwind and land here
            // before IsCancellationRequested has even flipped — without the status check that race
            // would relabel a deliberate cancellation as a download error.
            var cancelled = item.IsCancelled;

            item.Status = result.Success ? DownloadStatus.Complete
                : cancelled ? DownloadStatus.Cancelled
                : DownloadStatus.Error;

            item.Message = item.Status == DownloadStatus.Cancelled ? "" : result.Message;
            item.Percent = result.Success ? 100 : item.Percent;

            TrimFinished();
        });
    }

    private void Finish(DownloadItem item, DownloadStatus status, string message)
    {
        Update(() =>
        {
            item.Status = status;
            item.Message = message;
            TrimFinished();
        });
    }

    private void Cancel(DownloadItem item)
    {
        if (!item.IsActive)
            return;

        // Settle the row here rather than waiting for the process to die. Tearing yt-dlp down can
        // take a noticeable while — on Windows Kill(entireProcessTree) walks the whole system
        // process table — and until then the row would sit spinning behind a button that does
        // nothing on a second press, because the token is already cancelled.
        Update(() =>
        {
            item.Status = DownloadStatus.Cancelled;
            item.Message = "";
            item.Percent = 0;
            item.Speed = "";
            item.Eta = "";

            TrimFinished();
        });

        var cts = item.Cts;

        // Off the render thread: Cancel() runs its registered callbacks synchronously on the
        // calling thread, and one of those callbacks is the process kill.
        _ = Task.Run(() =>
        {
            try { cts.Cancel(); }
            catch { /* already disposed, or a callback threw */ }
        });
    }

    /// <summary>
    /// Drops the oldest finished rows once the history exceeds <see cref="MaxFinished"/>. Callers
    /// must already hold <see cref="_sync"/>, so this cannot mutate the list while the pump is
    /// walking it to build the render tree.
    /// </summary>
    private void TrimFinished()
    {
        var finished = _downloads.Where(d => !d.IsActive).ToList();
        if (finished.Count <= MaxFinished)
            return;

        foreach (var stale in finished.Take(finished.Count - MaxFinished))
        {
            _downloads.Remove(stale);

            // Only once the background run has unwound. A cancelled row is marked finished while
            // its process is still being killed, and disposing the token source out from under
            // that teardown would fault it.
            if (stale.Settled)
                stale.Cts.Dispose();
        }
    }

    private async Task ChangeFolder()
    {
        var newFolder = await FolderPicker.PickFolderAsync();
        if (string.IsNullOrEmpty(newFolder))
        {
            SetFolderMessage("No folder selected. Your current folder remains unchanged.", Theme.Notice);
            return;
        }

        try
        {
            Directory.CreateDirectory(newFolder);
            Update(() => Config.Config.DownloadFolder = newFolder);
            await Config.SaveAsync();
            SetFolderMessage("✓ Folder saved!", Theme.Success);
        }
        catch (Exception ex)
        {
            SetFolderMessage($"✗ Invalid path: {ex.Message}", Theme.Error);
        }
    }

    private void OpenDownloadFolder()
    {
        if (FolderPicker.OpenFolder(Config.Config.DownloadFolder))
            return;

        SetFolderMessage($"✗ Could not open {Config.Config.DownloadFolder}", Theme.Error);
    }

    private void SetFolderMessage(string message, Color color)
    {
        int sequence = 0;

        Update(() =>
        {
            _folderMessage = message;
            _folderMessageColor = color;

            // Sequence-stamped so a later message cannot be wiped by an earlier one's expiry.
            sequence = ++_folderMessageSeq;
        });

        _ = ExpireFolderMessageAsync(sequence);
    }

    /// <summary>
    /// Clears the folder notice after a few seconds. Without this it is set in four places and
    /// reset in none, so "✓ Folder saved!" stays on screen for the rest of the session.
    /// </summary>
    private async Task ExpireFolderMessageAsync(int sequence)
    {
        await Task.Delay(FolderMessageLifetime);

        Update(() =>
        {
            if (sequence == _folderMessageSeq)
                _folderMessage = "";
        });
    }

    public void Dispose()
    {
        InputLoop.Unregister(RenderIfDirty);
        InputLoop.UnregisterShortcuts(HandleShortcut);
        _pump?.Cancel();
        _pump?.Dispose();

        foreach (var item in _downloads)
        {
            try
            {
                item.Cts.Cancel();
            }
            catch
            {
                // Already disposed, or a kill callback threw.
            }

            // Not disposed unless the run has unwound: a still-running teardown holds this token.
            if (!item.Settled)
                continue;

            try { item.Cts.Dispose(); }
            catch (ObjectDisposedException) { /* already disposed by TrimFinished */ }
        }

        // _slots is deliberately not disposed: nothing ever touches its AvailableWaitHandle, so
        // it holds no unmanaged resource, and disposing it would fault any RunAsync still parked
        // in WaitAsync or about to Release.
    }

    // ---- row rendering -------------------------------------------------------------------
    //
    // Each row is a single Markup or Spinner rather than a Columns of coloured fragments:
    // RazorConsole escapes a component's Content, so inline Spectre colour tags are not an
    // option and every colour change would cost another cell of unpredictable width.

    /// <summary>
    /// Recomputes the label/bar split from the live console width. Called once per render rather
    /// than once per row so a resize mid-download cannot produce rows of differing widths.
    /// </summary>
    private static RowLayout Measure()
    {
        var width = ConsoleWidth();

        var rowWidth = Math.Max(20, width - 4);

        // What an active row's text may occupy: the full width less the spinner, the trailing
        // " [ Cancel ]" and the panel border.
        var activeWidth = Math.Max(16, width - 17);

        // The speed and ETA are the first thing to go when the terminal is too narrow to hold
        // everything, since the bar and the filename are what the row exists to show.
        var budget = width - RowChrome - RateWidth;
        var showRate = budget >= MinLabel + MinBar;

        if (!showRate)
            budget = width - RowChrome;

        budget = Math.Max(MinLabel + MinBar, budget);

        // The bar takes the minority share: past roughly 40 cells it stops conveying anything
        // new, whereas a longer label is what actually tells two downloads apart.
        var barWidth = Math.Clamp(budget * 2 / 5, MinBar, 40);
        var labelWidth = Math.Clamp(budget - barWidth, MinLabel, 64);

        return new RowLayout(labelWidth, barWidth, rowWidth, activeWidth, showRate);
    }

    private static int ConsoleWidth()
    {
        try
        {
            var width = Spectre.Console.AnsiConsole.Profile.Width;
            return width > 0 ? width : 80;
        }
        catch
        {
            // Redirected or otherwise unmeasurable output.
            return 80;
        }
    }

    /// <summary>What an active row shows after its title, and in which colours.</summary>
    /// <param name="Progress">The bar, or a word standing in for it while there is none.</param>
    /// <param name="Value">The percentage, or the stage name while converting.</param>
    /// <param name="Detail">Secondary text in grey: speed and ETA, or why a retry is waiting.</param>
    private readonly record struct ActiveCells(
        string SpinnerStyle,
        string Progress,
        Color ProgressColor,
        string Value,
        Color ValueColor,
        Decoration ValueDecoration,
        string Detail);

    private static ActiveCells CellsFor(DownloadItem item, RowLayout layout) => item.Status switch
    {
        DownloadStatus.Queued => new(
            Theme.Muted.ToMarkup(), Fit("Queued", layout.Bar), Theme.Muted,
            "", Theme.Muted, Decoration.None, ""),

        // The countdown takes the bar's place, in the warning colour, and the reason follows in
        // grey where speed and ETA would be: it is the part worth losing when space runs short.
        DownloadStatus.Retrying => new(
            Theme.Warn.ToMarkup(), Fit($"Retry {item.Attempt + 1}/{MaxAttempts} in {item.RetryIn}s", layout.Bar), Theme.Warn,
            "", Theme.Warn, Decoration.None, Truncate(item.Message, RateWidth + 7)),

        DownloadStatus.Converting => new(
            Theme.Notice.ToMarkup(), Bar(100, layout), Theme.Notice,
            item.Format == DownloadFormat.Mp3 ? "Converting" : "Merging", Theme.Notice, Decoration.None, ""),

        _ => new(
            Theme.Accent.ToMarkup(), Bar(item.Percent, layout), Theme.Accent,
            $"{item.Percent,5:F1}%", Color.Default, Decoration.Bold, Rate(item, layout)),
    };

    private static string FinishedLine(DownloadItem item, RowLayout layout) => item.Status switch
    {
        DownloadStatus.Complete when item.IsPlaylist =>
            Truncate($"✓ Saved {item.PlaylistCount} files  →  {Shorten(item.Folder)}", layout.Row),

        DownloadStatus.Complete when !string.IsNullOrEmpty(item.FileName) =>
            Truncate($"✓ Saved  {item.FileName}  →  {Shorten(item.Folder)}", layout.Row),

        DownloadStatus.Complete =>
            Truncate($"✓ Saved to {Shorten(item.Folder)}", layout.Row),

        DownloadStatus.Cancelled =>
            Truncate($"– Cancelled  {Fit(LabelOf(item), layout.Label).TrimEnd()}", layout.Row),

        // Deliberately not truncated: an error is the one row where losing the tail of the text
        // costs the user the reason, so a long message is left to wrap onto a second line.
        _ =>
            $"✗ {item.Message}",
    };

    private static Color FinishedColor(DownloadItem item) => item.Status switch
    {
        DownloadStatus.Complete => Theme.Success,
        DownloadStatus.Cancelled => Theme.Muted,
        _ => Theme.Error,
    };

    private static string Rate(DownloadItem item, RowLayout layout)
    {
        if (!layout.ShowRate)
            return "";

        var speed = CompactSpeed(item.Speed);

        if (string.IsNullOrEmpty(speed) && string.IsNullOrEmpty(item.Eta))
            return "";

        if (string.IsNullOrEmpty(item.Eta))
            return speed;

        if (string.IsNullOrEmpty(speed))
            return $"ETA {item.Eta}";

        return Truncate($"{speed} · {item.Eta}", RateWidth);
    }

    /// <summary>
    /// Trims yt-dlp's two-decimal rate to at most one significant decimal ("850.00KiB/s" becomes
    /// "850KiB/s"). Those three characters are what keeps a slow download with an hours-long ETA
    /// inside 80 columns.
    /// </summary>
    private static string CompactSpeed(string speed)
    {
        if (string.IsNullOrEmpty(speed))
            return speed;

        var digits = 0;
        while (digits < speed.Length && (char.IsAsciiDigit(speed[digits]) || speed[digits] == '.'))
            digits++;

        if (digits == 0 || !double.TryParse(
                speed[..digits], NumberStyles.Float, CultureInfo.InvariantCulture, out var value))
            return speed;

        var unit = speed[digits..];
        return value >= 100 ? $"{value:F0}{unit}" : $"{value:F1}{unit}";
    }

    private static string Bar(double percent, RowLayout layout)
    {
        // Floor, not round: at 99.9% a rounded bar is already full, which reads as finished.
        var filled = (int)Math.Floor(Math.Clamp(percent, 0, 100) / 100d * layout.Bar);
        return new string('█', filled) + new string('░', layout.Bar - filled);
    }

    /// <summary>
    /// Display width in terminal cells. Measured with Spectre's own counter rather than
    /// string.Length, because one CJK glyph occupies two columns: a Japanese track title padded
    /// by character count pushes the bar right and breaks the column alignment of every row.
    /// </summary>
    private static int CellWidth(string text) =>
        Spectre.Console.Rendering.Segment.CellCount([new Spectre.Console.Rendering.Segment(text)]);

    /// <summary>Truncates to at most <paramref name="width"/> cells, marking any cut with an ellipsis.</summary>
    private static string Truncate(string text, int width)
    {
        if (width <= 0 || string.IsNullOrEmpty(text))
            return "";

        if (CellWidth(text) <= width)
            return text;

        var end = 0;
        var used = 0;

        while (end < text.Length)
        {
            // Surrogate pairs advance two chars but measure as one glyph.
            var step = char.IsSurrogatePair(text, end) ? 2 : 1;
            var cells = CellWidth(text.Substring(end, step));

            if (used + cells > width - 1)
                break;

            used += cells;
            end += step;
        }

        return string.Concat(text.AsSpan(0, end), "…");
    }

    /// <summary>Pads or ellipsises to an exact cell width so bars line up across rows.</summary>
    private static string Fit(string text, int width)
    {
        if (string.IsNullOrEmpty(text))
            return new string(' ', width);

        var trimmed = Truncate(text, width);
        return trimmed + new string(' ', Math.Max(0, width - CellWidth(trimmed)));
    }

    /// <summary>
    /// A "list=" parameter is what makes yt-dlp expand a link into a whole playlist, and it rides
    /// along on most URLs copied from YouTube while a playlist is open.
    /// </summary>
    private static bool HasPlaylist(string url) =>
        url.Contains("list=", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// "This video only" for a link that names a video inside a playlist; "First video only" for
    /// a link to the playlist itself, where there is no particular video to mean.
    /// </summary>
    private static string SingleItemLabel(string url) =>
        YouTubeIds(url) is { Video: null } ? "First video only" : "This video only";

    /// <summary>
    /// What a download is of, for spotting a duplicate: the YouTube video or playlist ID where
    /// there is one, otherwise the link without its fragment.
    /// </summary>
    private static string DownloadKey(string url, bool wholePlaylist)
    {
        if (YouTubeIds(url) is { } ids)
        {
            if (wholePlaylist && ids.List is not null)
                return "youtube-list:" + ids.List;

            if (ids.Video is not null)
                return "youtube:" + ids.Video;

            if (ids.List is not null)
                return "youtube-list:" + ids.List;
        }

        var hash = url.IndexOf('#');
        return hash >= 0 ? url[..hash] : url;
    }

    /// <summary>
    /// The video and playlist IDs a YouTube link carries, either of which may be null. Null
    /// altogether for a link that is not YouTube's.
    /// </summary>
    private static (string? Video, string? List)? YouTubeIds(string url)
    {
        if (!Uri.TryCreate(url.Trim(), UriKind.Absolute, out var uri))
            return null;

        var host = uri.Host.ToLowerInvariant();
        var isShortLink = host is "youtu.be" or "www.youtu.be";
        var isYouTube = isShortLink
            || host is "youtube.com" or "youtube-nocookie.com"
            || host.EndsWith(".youtube.com", StringComparison.Ordinal)
            || host.EndsWith(".youtube-nocookie.com", StringComparison.Ordinal);

        if (!isYouTube)
            return null;

        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var segments = uri.AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries);

        var video = query["v"];
        if (string.IsNullOrEmpty(video))
        {
            if (isShortLink && segments.Length > 0)
                video = segments[0];
            else if (segments.Length > 1 && (segments[0] is "shorts" or "live" or "embed"))
                video = segments[1];
        }

        var list = query["list"];

        return (string.IsNullOrEmpty(video) ? null : video, string.IsNullOrEmpty(list) ? null : list);
    }

    /// <summary>Row label, prefixed with the playlist position once one is known.</summary>
    private static string LabelOf(DownloadItem item) =>
        item.IsPlaylist ? $"{item.PlaylistIndex}/{item.PlaylistCount} {item.Label}" : item.Label;

    /// <summary>Collapses the home directory to <c>~</c> so paths fit an 80-column terminal.</summary>
    private static string Shorten(string path)
    {
        var home = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);

        // The match has to end at a separator, or a home of C:\Users\Bob would also claim
        // C:\Users\Bobby and show it as "~by".
        var underHome = !string.IsNullOrEmpty(home)
            && path.StartsWith(home, StringComparison.OrdinalIgnoreCase)
            && (path.Length == home.Length
                || path[home.Length] == Path.DirectorySeparatorChar
                || path[home.Length] == Path.AltDirectorySeparatorChar);

        return underHome ? string.Concat("~", path.AsSpan(home.Length)) : path;
    }
}
